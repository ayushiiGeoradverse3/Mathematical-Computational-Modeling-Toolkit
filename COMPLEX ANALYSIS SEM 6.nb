          RowBox[{"2", " ", "t"}]}], ")"}]}]}], ")"}]}]], 
   RowBox[{"\[DifferentialD]", "t"}]}]}]], "Output",
 CellChangeTimes->{3.983965880300278*^9},
 CellLabel->"Out[56]=",ExpressionUUID->"17b83b4b-c1cd-49b7-ae13-5367ef26b459"]
}, Open  ]],

