Cell[CellGroupData[{

Cell[TextData[{
 "Q)Integrate f(z) = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"(", 
     RowBox[{"z", "+", "2"}], ")"}], "z"], TraditionalForm]],ExpressionUUID->
  "3a53cb6a-2a63-4ba1-9683-52e4314bb478"],
 " along the contour C , where \na) C is the semicircle z = 2 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", "it"], TraditionalForm]],ExpressionUUID->
  "f8658f7c-52f5-4ef7-8463-f70c556305a1"],
 ", 0\[LessEqual]t\[LessEqual]\[Pi]\nb) C is the semicircle z= 2 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", "it"], TraditionalForm]],ExpressionUUID->
  "be13ffa4-1bae-4452-bb2f-08cd95f01954"],
 " , \[CapitalPi]\[LessEqual]t\[LessEqual]2\[Pi]\nAlso draw the curve C"
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839690697122355`*^9, 
  3.983969254386628*^9}, {3.984025819566472*^9, 
  3.984025887771496*^9}},ExpressionUUID->"e9c828dd-3d77-4976-b93f-\
c4e4aa2f917a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "t_", "]"}], "=", 
   RowBox[{"2", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", "t"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{"z", "+", "2"}], ")"}], "z"]}], ";"}], "\n", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", "*", 
      RowBox[{"Cos", "[", "t", "]"}]}], ",", 
     RowBox[{"2", "*", 
      RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "Pi"}], "}"}]}], "]"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"f", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"z", "'"}], "[", "t", "]"}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "Pi"}], "}"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
  3.9839692663608356`*^9, 3.9839692853985376`*^9}, {3.983969333214243*^9, 
