   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", "z", ")"}]}], "=", 
    FractionBox["3", 
     RowBox[{"2", "+", "z", "-", 
      SuperscriptBox["z", "2"]}]]}], TraditionalForm]],ExpressionUUID->
  "544c7831-50b0-42f7-877d-e61669dfcf9a"],
