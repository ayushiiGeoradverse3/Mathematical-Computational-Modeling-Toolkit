Cell[CellGroupData[{

Cell["\<\
Evaluate the integral of exp(2/z) over c1+(0) denoting the circle {z:| z | \
=1} with positive orientation . Similarly evaluate the integral of \
1/(z^4+z^3-2 z^2).\
\>", "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839660956298857`*^9, 
  3.983966156738639*^9}, {3.983967874498677*^9, 3.9839679093198175`*^9}, {
  3.983967992610083*^9, 3.9839680225095873`*^9}, {3.983968056802614*^9, 
  3.983968178263564*^9}, {3.9839716587394733`*^9, 3.9839717016632867`*^9}, {
  3.983972685027308*^9, 3.983972721981763*^9}, {3.9839733100586777`*^9, 
  3.983973419692049*^9}, {3.986902528801551*^9, 3.986902536075205*^9}, {
  3.9869026548011446`*^9, 
  3.986902782074212*^9}},ExpressionUUID->"daaac219-1ebd-42d9-94de-\
0f47cae6dce2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "t_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Cos", "[", "t", "]"}], "+", " ", 
    RowBox[{"I", "*", 
     RowBox[{"Sin", "[", "t", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", " ", 
  RowBox[{"Exp", "[", 
   RowBox[{"2", "/", "z"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"g", "[", "t", "]"}], "]"}], "*", 
    RowBox[{
     RowBox[{"g", "'"}], "[", "t", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"2", "*", "Pi"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
  3.983968201303645*^9, 3.9839683314811687`*^9}, {3.983971741385665*^9, 
