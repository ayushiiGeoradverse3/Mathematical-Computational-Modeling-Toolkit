Cell[CellGroupData[{

Cell[TextData[{
 "Q2) Plot the circle with radius 2 and center z=3 and evaluate the integral \
along the contour C ",
 Cell[BoxData[
  RowBox[{
   SubsuperscriptBox["\[Integral]", "C", "\[Placeholder]"], 
   RowBox[{
    FractionBox["1", 
     RowBox[{"z", "-", "1"}]], 
    RowBox[{"\[DifferentialD]", "z"}]}]}]], "Text",
  CellChangeTimes->{{3.9839640744937572`*^9, 3.9839640832747664`*^9}},
  ExpressionUUID->"fb924a0e-1588-4402-aef8-61ddb30b60f5"],
 " ",
 Cell[BoxData[
  RowBox[{"and", " ", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "C", "\[Placeholder]"], 
    RowBox[{
     FractionBox["1", 
      RowBox[{"z", 
       RowBox[{"(", 
        RowBox[{"z", "-", "1"}], ")"}]}]], 
     RowBox[{"\[DifferentialD]", "z"}]}]}]}]], "Text",
  CellChangeTimes->{{3.9839640744937572`*^9, 3.9839640832747664`*^9}},
  ExpressionUUID->"07ca260c-81e3-4817-84bb-2df3d41ccd51"],
 " ."
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
   3.9839620963056555`*^9, 3.983962098443106*^9}, {3.98396398143118*^9, 
   3.9839639923542004`*^9}, {3.983964091761257*^9, 3.9839642058019805`*^9}, 
   3.9839642912087016`*^9, {3.983964971053302*^9, 
   3.9839651105283117`*^9}},ExpressionUUID->"660d7022-c473-46b9-ac4e-\
054a12989acc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"s", "[", "t_", "]"}], ":=", 
  RowBox[{"3", "+", 
   RowBox[{"2", "*", 
    RowBox[{"Cos", "[", "t", "]"}]}], "+", 
   RowBox[{"I", "*", "2", "*", 
    RowBox[{"Sin", "[", "t", "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"I1", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s", "[", "t", "]"}], "-", "1"}], ")"}]}], "*", 
     RowBox[{
      RowBox[{"s", "'"}], "[", "t", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", 
      RowBox[{"2", "Pi"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
