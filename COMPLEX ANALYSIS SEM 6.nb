Cell[CellGroupData[{

Cell[TextData[{
 "Q) Plot the semicircle C with radius 1 centered at z = 2 and evaluate the \
contour integral of \[Integral]c ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"z", "-", "2"}]], TraditionalForm]],ExpressionUUID->
  "83ee9a67-15d3-489b-bbc0-7468817fab62"],
 " \[DifferentialD]z."
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839690697122355`*^9, 
  3.983969254386628*^9}, {3.984025819566472*^9, 3.984025887771496*^9}, {
  3.984026098956182*^9, 3.984026109668353*^9}, {3.984026239280531*^9, 
  3.9840262711077557`*^9}},ExpressionUUID->"cb2fa37d-f667-499f-8204-\
3b8365e61e85"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "t_", "]"}], "=", 
   RowBox[{"2", "+", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", "t"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   FormBox[
    FractionBox["1", 
     RowBox[{"z", "-", "2"}]],
    TraditionalForm]}], ";"}], "\n", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Re", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], ",", 
     RowBox[{"Im", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "Pi"}], "}"}]}], "]"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"f", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"z", "'"}], "[", "t", "]"}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "Pi"}], "}"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
  3.9839692663608356`*^9, 3.9839692853985376`*^9}, {3.983969333214243*^9, 
  3.983969372773285*^9}, {3.9839694240341372`*^9, 3.983969552716604*^9}, {
  3.9840259132672195`*^9, 3.9840259302950664`*^9}, {3.9840261706753397`*^9, 
