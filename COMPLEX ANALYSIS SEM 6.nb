  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"g", "[", "t", "]"}], "]"}], "*", 
    RowBox[{
     RowBox[{"g", "'"}], "[", "t", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}], "\n"}], "Input",
