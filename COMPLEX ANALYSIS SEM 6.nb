Cell[CellGroupData[{

Cell["\<\
13. Plot image of circle |z|=1 under the function f(z)=(1-z)/(1+z).\
\>", "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839690697122355`*^9, 
  3.983969254386628*^9}, {3.9839740477136135`*^9, 3.9839740529493046`*^9}, {
  3.983974129347575*^9, 3.9839741387540455`*^9}, {3.9839742001242504`*^9, 
  3.9839742047262*^9}, {3.9839743872651205`*^9, 3.983974387496023*^9}, {
  3.983974453229542*^9, 3.983974458134021*^9}, {3.983974551294177*^9, 
  3.983974588341386*^9}, {3.9839764055708656`*^9, 3.9839764061127625`*^9}, {
  3.983976647289385*^9, 3.9839766634583335`*^9}, {3.983976800897541*^9, 
  3.983976825701005*^9}, {3.9840231004617467`*^9, 3.984023145904991*^9}, {
  3.984023307507716*^9, 3.984023325053892*^9}, {3.9840234247970104`*^9, 
  3.9840234558682947`*^9}, {3.984023599571032*^9, 3.9840236208961587`*^9}, {
  3.984023712774513*^9, 3.9840237287246494`*^9}, {3.9840238143228846`*^9, 
  3.9840238309164515`*^9}},ExpressionUUID->"f78995f3-2f10-4137-9984-\
0c8fa9d12139"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   FractionBox[
    RowBox[{"(", 
     RowBox[{"1", "-", "z"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"1", "+", "z"}], ")"}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "t_", "]"}], "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"f", "[", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", "*", "t"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", "t", "]"}], ",", 
       RowBox[{"Sin", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"g", "[", "t", "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"g", "[", "t", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", "*", "Pi"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Green"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"p1", ",", "p2"}], "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
   3.9839692663608356`*^9, 3.9839692853985376`*^9}, {3.983969333214243*^9, 
   3.983969372773285*^9}, {3.9839694240341372`*^9, 3.983969552716604*^9}, {
