Cell[CellGroupData[{

Cell[TextData[{
 "6.  Plot the image of right branch of hyperbola ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "7762adcb-60f6-4896-bfd2-ac43effdc2a9"],
 " - ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "7d06b4ea-0d03-40a6-b7cb-73978679f8eb"],
 "= 1 under \nthe function f(z) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["z", "2"], TraditionalForm]],ExpressionUUID->
  "c2612d7c-cc18-4c0f-8cf4-9e61099fc849"],
 "."
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
