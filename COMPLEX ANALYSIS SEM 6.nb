485d9e150584"],

Cell["ML INEQUALITY", "BookChapterTitle",
 CellChangeTimes->{{3.983961839217885*^9, 3.9839618482966976`*^9}, {
  3.9839714781049395`*^9, 3.983971487535087*^9}},
 CellTags->"c:12",ExpressionUUID->"f30c3eb0-775e-421e-a58f-c1a1bf0fe6ef"],

Cell[CellGroupData[{

Cell[TextData[{
 "Use ML inequality to show absolute value of integral \[LeftBracketingBar]",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{
     SuperscriptBox["z", "2"], "+", "1"}]], TraditionalForm]],ExpressionUUID->
  "3b3b1a01-4030-4bb6-9c93-92bd659de36f"],
 "\[RightBracketingBar]\[LessEqual] ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", 
    RowBox[{"2", 
     RowBox[{"\[Sqrt]", "5"}]}]], TraditionalForm]],ExpressionUUID->
  "5d82cf94-6813-4f71-a1ed-fbaa0ce5c57a"],
 " where C is the straight line segment from 2 to 2+i. While solving \
represent the distance from the point \[OpenCurlyQuote]z\[CloseCurlyQuote] to \
the points \[OpenCurlyQuote]i\[CloseCurlyQuote] & \[OpenCurlyQuote]-i\
\[CloseCurlyQuote] respectively, i.e. |z-i| and |z+i| on the complex plane \
\[DoubleStruckCapitalC]."
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839660956298857`*^9, 
  3.983966156738639*^9}, {3.983967874498677*^9, 3.9839679093198175`*^9}, {
  3.983967992610083*^9, 3.9839680225095873`*^9}, {3.983968056802614*^9, 
  3.983968178263564*^9}},ExpressionUUID->"82eb26d9-1e9e-4b47-aeb3-\
6179335fb431"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"2", "+", "I"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "t_", "]"}], ":=", 
   RowBox[{"A", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"B", "-", "A"}], ")"}], "*", "t"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f", "[", "z_", "]"}], ":=", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"z", "^", "2"}], "+", "1"}], ")"}]}]}], "\n", 
 RowBox[{"V", "=", 
  RowBox[{"N", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"g", "[", "t", "]"}], "]"}], "*", 
       RowBox[{
        RowBox[{"g", "'"}], "[", "t", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"V", "<=", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", 
      RowBox[{"Sqrt", "[", "5", "]"}]}], ")"}]}]}], "\n"}], "\n"}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
  3.983968201303645*^9, 3.9839683314811687`*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"4559d4d0-25d0-4290-8c91-3ddf759a2258"],

Cell[BoxData["0.18724851640593007`"], "Output",
 CellChangeTimes->{3.983968338636577*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"7ad7a334-1254-4414-8c79-172e01372d78"],

