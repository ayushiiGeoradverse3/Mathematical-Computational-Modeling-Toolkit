Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"h", "[", "z_", "]"}], ":=", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"z", "^", "4"}], "+", 
     RowBox[{"z", "^", "3"}], "-", 
     RowBox[{"2", "*", 
      RowBox[{"z", "^", "2"}]}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"h", "[", 
     RowBox[{"g", "[", "t", "]"}], "]"}], "*", 
    RowBox[{
