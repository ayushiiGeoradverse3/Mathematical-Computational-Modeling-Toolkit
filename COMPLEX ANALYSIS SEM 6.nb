In[261]:=",ExpressionUUID->"a172832c-35e3-4854-8017-deeed99436c2"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"The singularities are:\"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[ImaginaryI]", 
       SqrtBox["5"]]}], ",", 
     FractionBox["\[ImaginaryI]", 
      SqrtBox["5"]], ",", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", 
      SqrtBox["5"]}], ",", 
     RowBox[{"2", "+", 
      FractionBox["\[ImaginaryI]", "2"]}]}], "}"}]}],
  SequenceForm[
  "The singularities are:", {
   Complex[0, -1] 5^Rational[-1, 2], Complex[0, 1] 5^Rational[-1, 2], 
    Complex[0, -1] 5^Rational[1, 2], 
    Complex[2, 
     Rational[1, 2]]}],
  Editable->False]], "Print",
 CellChangeTimes->{{3.9839728657626314`*^9, 3.9839728849694057`*^9}, {
   3.9839729279038286`*^9, 3.9839729343714*^9}, 3.9839729852901926`*^9, 
