  FormBox[
   FractionBox[
    RowBox[{"\[Pi]", " ", "cot", 
     RowBox[{"(", "\[Pi]z", ")"}]}], 
    SuperscriptBox["Z", "2"]], TraditionalForm]],ExpressionUUID->
  "dfc98752-9762-43d5-8249-d93181c238aa"],
 " and determine their order. \nAlso justify that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Res", " ", 
     RowBox[{"(", 
      RowBox[{"g", ",", " ", "0"}], ")"}]}], " ", "=", " ", 
    FractionBox[
     SuperscriptBox["\[Pi]", "2"], "3"]}], TraditionalForm]],ExpressionUUID->
  "373a3103-4ea3-4465-8979-58334f981afb"]
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
