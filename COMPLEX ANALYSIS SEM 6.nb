  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", "z", ")"}]}], "=", 
    FractionBox["1", "z"]}], TraditionalForm]],ExpressionUUID->
  "be14b24f-f4e3-445d-b281-63a9fa605e55"],
 StyleBox[" \:201az along the curve C where C is given by z(t) = ",
  FontWeight->"Bold"],
 "RCos[t]+i Sin[t]",
 StyleBox[" , 0<=t<=2Pi , R is not equal to zero.",
  FontWeight->"Bold"]
}], "Text",
