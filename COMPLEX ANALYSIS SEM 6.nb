Cell["LOCATE THE POLES", "BookChapterTitle",
 CellChangeTimes->{{3.983961839217885*^9, 3.9839618482966976`*^9}, {
  3.9839714781049395`*^9, 3.983971487535087*^9}, {3.983971636159943*^9, 
