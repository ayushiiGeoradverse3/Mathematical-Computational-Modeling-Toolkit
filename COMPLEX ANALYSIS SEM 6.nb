  RowBox[{"f", "[", "z_", "]"}], ":=", 
  RowBox[{"Exp", "[", "z", "]"}]}], "\n", 
 RowBox[{
  RowBox[{"g", "[", "t_", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"2", "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"Pi", "/", "4"}], ")"}], "*", "I"}]}], ")"}], "*", 
   "t"}]}], "\n", 
