Cell[CellGroupData[{

Cell[TextData[{
 "Q) Plot the semicircle \[OpenCurlyQuote]C\[CloseCurlyQuote] with radius 1 \
centered at z = 2 and evaluate the integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "C", "\[Placeholder]"], 
    RowBox[{
     FractionBox["1", 
      RowBox[{"z", "-", "2"}]], 
     RowBox[{"\[DifferentialD]", "z"}]}]}], TraditionalForm]],ExpressionUUID->
  "b84eaa8a-cc16-4656-b015-11f72352e655"]
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
