Cell[CellGroupData[{

Cell["\<\
8.Plot the image of region bounded by lines x =1, x = 5, y=1, y=5 under the \
function f(z) = z2.\
\>", "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839690697122355`*^9, 
  3.983969254386628*^9}, {3.9839740477136135`*^9, 3.9839740529493046`*^9}, {
  3.983974129347575*^9, 3.9839741387540455`*^9}, {3.9839742001242504`*^9, 
  3.9839742047262*^9}, {3.9839743872651205`*^9, 3.983974387496023*^9}, {
  3.983974453229542*^9, 3.983974458134021*^9}, {3.983974551294177*^9, 
  3.983974588341386*^9}, {3.9839764055708656`*^9, 3.9839764061127625`*^9}, {
  3.983976647289385*^9, 3.9839766634583335`*^9}, {3.983976800897541*^9, 
  3.983976825701005*^9}, {3.9840231004617467`*^9, 3.984023145904991*^9}, {
  3.984023307507716*^9, 
  3.984023325053892*^9}},ExpressionUUID->"5ad6ec72-e146-41c8-984f-\
cb72cd2ed899"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   RowBox[{"z", "^", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"f", "[", 
     RowBox[{"x", "+", 
      RowBox[{"I", "*", "y"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"p7", "=", 
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "1", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "1", ",", "5"}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"p6", "=", 
  RowBox[{"ParametricPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"g", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "]"}], ",", 
      RowBox[{"Im", "[", 
       RowBox[{"g", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "1", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "1", ",", "5"}], "}"}], ",", 
    RowBox[{"PlotStyle", "->", "Green"}]}], "]"}]}], "\n"}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
   3.9839692663608356`*^9, 3.9839692853985376`*^9}, {3.983969333214243*^9, 
