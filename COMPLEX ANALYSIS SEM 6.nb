Cell[CellGroupData[{

Cell[TextData[{
 "7.  Plot the image of line segment x = 1, -5 \[LessEqual] y \[LessEqual] 5 \
under the  function f(z)= ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["z", "2"], TraditionalForm]],ExpressionUUID->
  "fa337531-73d1-4337-80d3-8ab68dbaacf9"],
 "."
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839690697122355`*^9, 
  3.983969254386628*^9}, {3.9839740477136135`*^9, 3.9839740529493046`*^9}, {
