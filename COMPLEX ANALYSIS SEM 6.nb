 RowBox[{
  RowBox[{"g", "[", "t_", "]"}], ":=", 
  RowBox[{
   RowBox[{"R", "*", 
    RowBox[{"Cos", "[", "t", "]"}]}], "+", 
   RowBox[{"I", "*", "R", "*", 
    RowBox[{"Sin", "[", "t", "]"}]}]}]}], "\n", 
 RowBox[{
  RowBox[{"j", "[", "t_", "]"}], ":=", 
  RowBox[{"1", "/", 
   RowBox[{"g", "[", "t", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"j", "[", "t", "]"}], "*", 
    RowBox[{
     RowBox[{"g", "'"}], "[", "t", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"2", "*", "Pi"}]}], "}"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
