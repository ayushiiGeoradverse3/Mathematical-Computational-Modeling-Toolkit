 CellLabel->
  "In[261]:=",ExpressionUUID->"1e211e45-f115-4ee1-ab78-90991bb58303"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"q(t)=\"\>", "\[InvisibleSpace]", 
   FractionBox["1", 
    RowBox[{"5", "+", 
     RowBox[{"26", " ", 
      SuperscriptBox["t", "2"]}], "+", 
     RowBox[{"5", " ", 
      SuperscriptBox["t", "4"]}]}]]}],
  SequenceForm["q(t)=", (5 + 26 $CellContext`t^2 + 5 $CellContext`t^4)^(-1)],
  Editable->False]], "Print",
 CellChangeTimes->{{3.9839728657626314`*^9, 3.9839728849694057`*^9}, {
   3.9839729279038286`*^9, 3.9839729343714*^9}, 3.9839729852901926`*^9, 
