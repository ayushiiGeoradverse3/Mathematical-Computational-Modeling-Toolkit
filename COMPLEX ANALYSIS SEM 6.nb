Cell[CellGroupData[{

Cell[TextData[{
 "5 Plot the image of S = {z: |z| < 1 and 0 <= Argz <= Pi/6} under the \n\
function f(z) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["z", "3"], TraditionalForm]],ExpressionUUID->
  "d75f0196-5149-43b3-a5b5-db21f35d6dcb"],
 "."
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839690697122355`*^9, 
  3.983969254386628*^9}, {3.9839740477136135`*^9, 3.9839740529493046`*^9}, {
  3.983974129347575*^9, 3.9839741387540455`*^9}, {3.9839742001242504`*^9, 
  3.9839742047262*^9}, {3.9839743872651205`*^9, 3.983974387496023*^9}, {
  3.983974453229542*^9, 3.983974458134021*^9}, {3.983974551294177*^9, 
  3.983974588341386*^9}, {3.9839764055708656`*^9, 3.9839764061127625`*^9}, {
  3.983976647289385*^9, 
  3.9839766634583335`*^9}},ExpressionUUID->"ef0cf379-2427-4885-817e-\
0e4cd660f5d8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", "z", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   RowBox[{"z", "^", "3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p3", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", " ", 
        RowBox[{"Cos", "[", "t", "]"}]}], ",", 
       RowBox[{"r", " ", 
        RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"Pi", "/", "6"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Green"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"r_", ",", "t_"}], "]"}], "=", 
   RowBox[{"f", "[", 
    RowBox[{"r", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", " ", "t"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p4", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"g", "[", 
         RowBox[{"r", ",", "t"}], "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"g", "[", 
         RowBox[{"r", ",", "t"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"Pi", "/", "6"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p3", ",", "p4"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "1"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
   3.9839692663608356`*^9, 3.9839692853985376`*^9}, {3.983969333214243*^9, 
