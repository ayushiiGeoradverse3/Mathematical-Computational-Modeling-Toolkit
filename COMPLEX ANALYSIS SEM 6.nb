Cell[CellGroupData[{

Cell[TextData[{
 "9.Plot the image of vertical line segment x=1, -2<= y <=2 under the \
function f(z) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", "z"], TraditionalForm]],ExpressionUUID->
  "5d3004f2-b6a2-4e4d-987f-180ae40d1cd4"]
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839690697122355`*^9, 
  3.983969254386628*^9}, {3.9839740477136135`*^9, 3.9839740529493046`*^9}, {
  3.983974129347575*^9, 3.9839741387540455`*^9}, {3.9839742001242504`*^9, 
  3.9839742047262*^9}, {3.9839743872651205`*^9, 3.983974387496023*^9}, {
  3.983974453229542*^9, 3.983974458134021*^9}, {3.983974551294177*^9, 
  3.983974588341386*^9}, {3.9839764055708656`*^9, 3.9839764061127625`*^9}, {
  3.983976647289385*^9, 3.9839766634583335`*^9}, {3.983976800897541*^9, 
  3.983976825701005*^9}, {3.9840231004617467`*^9, 3.984023145904991*^9}, {
  3.984023307507716*^9, 3.984023325053892*^9}, {3.9840234247970104`*^9, 
  3.9840234558682947`*^9}},ExpressionUUID->"64ce1898-c703-4e94-9e1e-\
99fde8ab9a3e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   RowBox[{"Exp", "[", "z", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"f", "[", 
     RowBox[{"x", "+", 
      RowBox[{"I", "*", "y"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "y"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"g", "[", 
         RowBox[{"1", ",", "y"}], "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"g", "[", 
         RowBox[{"1", ",", "y"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", 
       RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Green"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"p1", ",", "p2"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "}"}]}]}], 
  "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
