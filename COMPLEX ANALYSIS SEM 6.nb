Cell[CellGroupData[{

Cell["\<\
Q) Evaluate contour integral \[Integral]c z \[DifferentialD]z where c is the \
right hand half of the circle |z| = 2 from -2i to 2i . Also Plot C . \
\>", "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839690697122355`*^9, 
  3.983969254386628*^9}, {3.984025819566472*^9, 3.984025887771496*^9}, {
  3.984026098956182*^9, 
  3.984026109668353*^9}},ExpressionUUID->"28127131-4f23-419e-befe-\
ed8f6cc72415"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"z", "[", "t_", "]"}], "=", 
   RowBox[{"2", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"I", "*", "t"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   RowBox[{"Conjugate", "[", "z", "]"}]}], ";"}], "\n", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"2", "*", 
      RowBox[{"Cos", "[", "t", "]"}]}], ",", 
     RowBox[{"2", "*", 
      RowBox[{"Sin", "[", "t", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{
      RowBox[{"-", "Pi"}], "/", "2"}], ",", 
     RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}], "\n", 
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"f", "[", 
      RowBox[{"z", "[", "t", "]"}], "]"}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"z", "'"}], "[", "t", "]"}], ")"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{
      RowBox[{"-", "Pi"}], "/", "2"}], ",", 
     RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
  3.9839692663608356`*^9, 3.9839692853985376`*^9}, {3.983969333214243*^9, 
  3.983969372773285*^9}, {3.9839694240341372`*^9, 3.983969552716604*^9}, {
  3.9840259132672195`*^9, 3.9840259302950664`*^9}, {3.9840261706753397`*^9, 
  3.9840262058697557`*^9}},
 CellLabel->"In[85]:=",ExpressionUUID->"37682336-aa18-4b39-b566-bd11f5a1a61f"],

