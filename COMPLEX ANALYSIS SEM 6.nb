 CellTags->"c:14",ExpressionUUID->"b3a6f969-d2a5-43d7-8e7c-afaae363d595"],

Cell[CellGroupData[{

Cell[TextData[{
 "Locate the poles of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", "z", ")"}]}], "=", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"5", 
       SuperscriptBox["z", "4"]}], "+", 
      RowBox[{"26", 
       SuperscriptBox["z", "2"]}], "+", "5"}]]}], TraditionalForm]],
  ExpressionUUID->"59bd28b2-498b-44c9-b81d-ccb42ea05888"],
 " and specify their order"
}], "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839660956298857`*^9, 
  3.983966156738639*^9}, {3.983967874498677*^9, 3.9839679093198175`*^9}, {
  3.983967992610083*^9, 3.9839680225095873`*^9}, {3.983968056802614*^9, 
  3.983968178263564*^9}, {3.9839716587394733`*^9, 3.9839717016632867`*^9}, {
  3.983972685027308*^9, 
  3.983972721981763*^9}},ExpressionUUID->"e2f6e82d-3117-47d0-8774-\
597e07ca685e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"q", "[", "t_", "]"}], ":=", 
  RowBox[{"1", "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"5", "*", 
      RowBox[{"t", "^", "4"}]}], "+", 
     RowBox[{"26", "*", 
      RowBox[{"t", "^", "2"}]}], "+", "5"}], ")"}]}]}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<q(t)=\>\"", ",", 
   RowBox[{"q", "[", "t", "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"solset", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Denominator", "[", 
        RowBox[{"f", "[", "t", "]"}], "]"}], "==", "0"}], ",", "t"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", "/.", 
      RowBox[{"solset", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", 
     RowBox[{"t", "/.", 
      RowBox[{"solset", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", 
     RowBox[{"t", "/.", 
      RowBox[{"solset", "[", 
       RowBox[{"[", "3", "]"}], "]"}]}], ",", 
     RowBox[{"z", "/.", 
      RowBox[{"solset", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<The singularities are:\>\"", ",", "S"}], "]"}]}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
  3.983968201303645*^9, 3.9839683314811687`*^9}, {3.983971741385665*^9, 
  3.983971872607014*^9}, {3.9839721640882072`*^9, 3.983972179022547*^9}, {
