Cell["GEOMETRIC PLOT nth ROOTS OF UNITY", "BookChapterTitle",
 CellChangeTimes->{{3.983961839217885*^9, 3.9839618482966976`*^9}, {
  3.983971230742859*^9, 3.9839712374068265`*^9}, {3.983974022488184*^9, 
  3.9839740313839693`*^9}, {3.983974337138838*^9, 3.983974352618005*^9}, {
  3.9857819159595923`*^9, 3.985781941261163*^9}},
 CellTags->"c:1",ExpressionUUID->"4ffc14b8-49ca-45db-bd6e-f1738dc214ca"],

Cell[CellGroupData[{

Cell["\<\
Make a geometric plot to show that the roots of unity are equally spaced \
points that lie on the unit circle C_{1}(0)={z:|z|=1} and form the vertices \
of a regular polygon with n sides , for n=4,5,6,7,8.\
\>", "Section",
 CellChangeTimes->{{3.9839616482795467`*^9, 3.983961767630446*^9}, {
  3.9839620963056555`*^9, 3.983962098443106*^9}, {3.9839690697122355`*^9, 
  3.983969254386628*^9}, {3.9839740477136135`*^9, 3.9839740529493046`*^9}, {
  3.9857822643909802`*^9, 3.9857823473408456`*^9}, {3.9857824121966352`*^9, 
  3.985782487852191*^9}},ExpressionUUID->"89ef6611-85ab-40fa-ade0-\
0fb4101f9e2c"],

Cell["a) For n=4", "Text",
 CellChangeTimes->{{3.9857824964468985`*^9, 
  3.9857825071190495`*^9}},ExpressionUUID->"d10e1d15-5fca-49b4-a069-\
ec77a5a94c9e"],

Cell[TextData[{
 "Here we have to find roots for ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["z", "4"], TraditionalForm]],ExpressionUUID->
  "030a04f6-8955-493a-a1c2-de252d99dbf0"],
 "=1"
}], "Text",
 CellChangeTimes->{{3.9857824964468985`*^9, 3.985782548852457*^9}, {
  3.9857826081132164`*^9, 
  3.9857826233265142`*^9}},ExpressionUUID->"2bcd4219-4bea-46e7-bd97-\
e14a65c6af57"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Sol", "=", 
  RowBox[{"ComplexExpand", "[", 
   RowBox[{"z", "/.", 
    RowBox[{"N", "[", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"z", "^", "4"}], "==", "1"}], "]"}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
  3.9839692663608356`*^9, 3.9839692853985376`*^9}, {3.983969333214243*^9, 
  3.983969372773285*^9}, {3.9839694240341372`*^9, 3.983969552716604*^9}, {
  3.98397406264931*^9, 3.9839740696049533`*^9}, {3.9857826388887587`*^9, 
  3.985782676482926*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"75f7ba83-7192-4a3c-9dab-a0513d95b9c8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "1.`"}], ",", 
   RowBox[{"0.`", "\[VeryThinSpace]", "-", 
    RowBox[{"1.`", " ", "\[ImaginaryI]"}]}], ",", 
   RowBox[{"0.`", "\[VeryThinSpace]", "+", 
    RowBox[{"1.`", " ", "\[ImaginaryI]"}]}], ",", "1.`"}], "}"}]], "Output",
