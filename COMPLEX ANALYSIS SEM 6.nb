Cell[CellGroupData[{

Cell[TextData[{
 "4. Show the effect of rotation of the ellipse (Q2) by an angle of ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[CapitalPi]", "6"], TraditionalForm]],ExpressionUUID->
  "48e2d6b1-dbb0-4db0-afed-9a873e5684de"],
 " radians and shifting of the centre from (0,0) to (2,1) by making a \
parametric plot."
