Cell[CellGroupData[{

Cell[TextData[{
 "16. Plot image of circle |z|=1 under the function f(z)=",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"(", 
     RowBox[{"z", "-", "1"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"z", "+", "1"}], ")"}]], TraditionalForm]],ExpressionUUID->
  "09bf7677-633e-48d8-8ce8-270f706360a9"],
