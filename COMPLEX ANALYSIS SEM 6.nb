   3.984024461694151*^9}},ExpressionUUID->"504312ba-c859-42a1-87b4-\
5f6b9d3eeb26"],

Cell["PLOTTING IMAGE OF DISK UNDER LINEAR TRANSFORMATION", "BookChapterTitle",
 CellChangeTimes->{{3.983961839217885*^9, 3.9839618482966976`*^9}, {
  3.983971230742859*^9, 3.9839712374068265`*^9}, {3.983974022488184*^9, 
  3.9839740313839693`*^9}, {3.983974337138838*^9, 3.983974352618005*^9}, {
  3.9840244739434137`*^9, 3.9840244975955086`*^9}},
 CellTags->"c:4",ExpressionUUID->"af8b246e-2f3d-49cd-852f-7e43d5a85c96"],

Cell[CellGroupData[{

Cell["\<\
1. Show that image of open disk D1 (-1 -i) = {z: |z+1+i| < 1} under the \
transformation w= f(z) = (3-4i)z +6+2i is the open disk \
\[LineSeparator]D5(-1+3i)= {w: |w+1-3i|<5}.\
\>", "Section",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQB2IQzfOJ49jZdW8d5+p8uQKi3x3n/Aei3+r6gelFp7al
XgTSTvFnakD0m6vfLl8G0lsS5l0B0WHy2vdAtIpixH0Qfecn83MQzWE7HUzf
q874B6Jz7ueD6YyI5WxXgPQzTxd2MJ35UghEL3rTJQ6iO1w2/QLRB2YfBtNL
nF5KXAXSq1e9kwLRK3bI6IDoRXlm+iB64bG+46+B9IavNmdBtJl9wUMQXbNz
4WMQLdMo+QFEC538/RlEP3X9xPoGSIeuncMBos+fkBAB0SEG4mIgWij0lAKI
nhR8VwlEPxAtdgTRC8NrwPQlS58EEN2j/jEJRJuoiWeB6BjX4lwQLaanUQ6i
0438wPSdEzuqQXT4XvU2EA0AhuzcpA==
  "],
 TextAlignment->Center,ExpressionUUID->"7d796ff7-8cdc-4b20-803f-bfae9786dec4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "z_", "]"}], "=", 
   RowBox[{
    RowBox[{"z", "*", 
     RowBox[{"(", 
      RowBox[{"3", "-", 
       RowBox[{"4", " ", "I"}]}], ")"}]}], "+", "6", "+", 
    RowBox[{"2", " ", "I"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"r_", ",", "t_"}], "]"}], "=", 
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"f", "[", 
     RowBox[{
      RowBox[{"r", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "t"}], "]"}]}], "-", "1", "-", "I"}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"r", " ", 
         RowBox[{"Cos", "[", "t", "]"}]}], "-", "1"}], ",", 
       RowBox[{
        RowBox[{"r", " ", 
         RowBox[{"Sin", "[", "t", "]"}]}], "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"g", "[", 
         RowBox[{"r", ",", "t"}], "]"}], "]"}], ",", 
       RowBox[{"Im", "[", 
        RowBox[{"g", "[", 
         RowBox[{"r", ",", "t"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
     RowBox[{"AxesOrigin", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{"p1", ",", "p2", ",", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "6"}], ",", "4"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "2"}], ",", "8"}], "}"}]}], "}"}]}]}], "]"}], 
  "\[IndentingNewLine]"}], "\n"}], "Input",
 CellChangeTimes->{{3.983961878454533*^9, 3.9839619480804567`*^9}, {
   3.9839692663608356`*^9, 3.9839692853985376`*^9}, {3.983969333214243*^9, 
   3.983969372773285*^9}, {3.9839694240341372`*^9, 3.983969552716604*^9}, {
