Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "*", 
        RowBox[{"Cos", "[", "t", "]"}]}], ",", 
       RowBox[{"Sin", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", "Red"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "q_", "]"}], "=", 
   RowBox[{
    RowBox[{"q", "*", 
     RowBox[{"Exp", "[", 
      RowBox[{"I", " ", 
       RowBox[{"Pi", "/", "6"}]}], "]"}]}], "+", "2", "+", "I"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "t_", "]"}], "=", 
   RowBox[{"f", "[", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"Cos", "[", "t", "]"}]}], "+", 
     RowBox[{"I", " ", 
      RowBox[{"Sin", "[", "t", "]"}]}]}], "]"}]}], 
