Cell[CellGroupData[{

Cell[TextData[{
 "15. Plot image of circle |z|=1 under the function f(z)=",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"(", 
     RowBox[{"z", "-", "1"}], ")"}], 
    RowBox[{"(", 
     RowBox[{"z", "+", "1"}], ")"}]], TraditionalForm]],ExpressionUUID->
  "f893787f-0541-45b4-9437-ad30804a0193"],
 "."
}], "Section",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBmIQzfOJ49jZdW8d5+p8uQKi3x3n/Aei3+r6gelFp7al
